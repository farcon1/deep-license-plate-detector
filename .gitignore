# ============================================================
# Model weights and ML artifacts
# ============================================================
# Store large weights outside Git or use Git LFS.

*.pth
*.onnx
*.engine
*.torchscript
*.tflite
*.pb
*.ckpt
*.safetensors
*.weights
*.bin

# Production model directories.
# The application expects local files here, but they should not be committed as normal Git blobs.
models/**/*.pth
models/**/*.onnx
models/**/*.engine
models/**/*.safetensors

# Keep empty model directories if .gitkeep files are used.
!models/.gitkeep
!models/detector/.gitkeep
!models/ocr/.gitkeep

